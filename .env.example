# Copy this file to server/.env and fill in your values

# PostgreSQL connection string from Supabase
# Go to: Supabase dashboard → Settings → Database → Connection string → URI
# Use the "Session mode" pooler URL (port 5432)
DATABASE_URL=postgresql://postgres.YOURPROJECTID:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Secret for session signing — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth credentials
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable "Google+ API" or "Google People API"
# 3. Go to Credentials → Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Authorized redirect URIs: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Where the React app runs in development
CLIENT_URL=http://localhost:5173

# Optional: Claude API key for AI-generated post descriptions
# Get yours at https://console.anthropic.com/
# If omitted, falls back to the hardcoded list of 65 descriptions
ANTHROPIC_API_KEY=

# Server port
PORT=3001
NODE_ENV=development
